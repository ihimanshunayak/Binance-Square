{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/test-storage",
      "schedule": "15 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/mcp/:secret",
      "destination": "/api/mcp?secret=:secret"
    }
  ]
}
