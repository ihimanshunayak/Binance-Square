# Copy these into your Vercel Project Settings > Environment Variables.
# Do not put real secrets in this file.
BINANCE_SQUARE_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=
MCP_SECRET_PATH=
CRON_SECRET=
NEWS_ENABLED=false
NEWS_CRON=0 */3 * * *
NEWS_TIMEZONE=Asia/Kolkata
NEWS_POSTS_PER_RUN=1
NEWS_POST_LANGUAGE=English
NEWS_DRY_RUN=true
# Use a persistent DB/Redis for news deduplication on Vercel; don't rely on local files.
