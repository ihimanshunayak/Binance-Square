# Add these values in Vercel Project Settings -> Environment Variables.
# Never commit real secret values.
BINANCE_SQUARE_API_KEY=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
MCP_SECRET_PATH=
CRON_SECRET=
NEWS_ENABLED=false
NEWS_DRY_RUN=true
NEWS_POSTS_PER_RUN=1
NEWS_MAX_AGE_HOURS=48
NEWS_POST_LANGUAGE=English
# generate (recommended: new original art), none (text only), or source (only with rights to reuse)
NEWS_IMAGE_MODE=generate
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
